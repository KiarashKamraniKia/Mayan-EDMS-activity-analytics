--- mayan/apps/storage/tests/test_compressed_files.py
+++ mayan/apps/storage/tests/test_compressed_files.py
@@ -608,32 +609,66 @@
     # silently skip (rather than raise) and let per-member checks
     # carry the burden of defense.
 
-    def test_non_seekable_input_skips_input_size_check(self):
+    class _NonSeekableWrapper:
+        """
+        A file-like wrapper that exposes only ``read``. Calling
+        ``tell`` or ``seek`` on it raises ``AttributeError`` (the
+        attributes are not defined), which is the signal
+        ``_get_seekable_size`` uses to identify a non-seekable input.
+        """
+
+        def __init__(self, file_object):
+            self._file_object = file_object
+
+        def read(self, size=-1):
+            return self._file_object.read(size)
+
+    def test_get_seekable_size_returns_none_for_non_seekable(self):
+        # Direct test of the module-level helper: a wrapper lacking
+        # ``tell``/``seek`` must yield ``None``, not raise.
+        with open(file=TEST_ARCHIVE_EML_SAMPLE_PATH, mode='rb') as file_object:
+            wrapper = self._NonSeekableWrapper(file_object=file_object)
+            self.assertIsNone(
+                _get_seekable_size(file_object=wrapper)
+            )
+
+    def test_check_input_size_skips_for_non_seekable(self):
+        # The defense layer must tolerate a non-seekable input by
+        # silently skipping, rather than letting the
+        # ``AttributeError`` from a missing ``tell`` propagate or
+        # raising ``ArchiveInputSizeExceeded`` against an unknown
+        # size.
         setting_compressed_file_input_size_maximum.do_value_override(
             value=8
         )
 
-        buffer = _build_zip_archive(
-            members=[('a.txt', b'hello', zipfile.ZIP_STORED)]
+        with open(file=TEST_ARCHIVE_EML_SAMPLE_PATH, mode='rb') as file_object:
+            wrapper = self._NonSeekableWrapper(file_object=file_object)
+            # Any Archive subclass exposes ``_check_input_size`` from
+            # the shared base. Use ``ZipArchive`` because instantiating
+            # it does no I/O of its own.
+            archive = ZipArchive()
+            # Must not raise.
+            archive._check_input_size(file_object=wrapper)
+
+    def test_check_input_size_skips_for_pipe_like(self):
+        # A file-like whose ``tell``/``seek`` are defined but raise
+        # ``OSError`` (e.g. a pipe or socket) must also be treated as
+        # "size unknown", not as an error.
+        setting_compressed_file_input_size_maximum.do_value_override(
+            value=8
         )
 
-        class _NonSeekableWrapper:
-            def __init__(self, file_object):
-                self._file_object = file_object
-
+        class _PipeLikeWrapper:
             def read(self, size=-1):
-                return self._file_object.read(size)
+                return b''
 
-            # No `seek` or `tell` exposed — `Archive._check_input_size`
-            # must treat this as size-unknown and skip the check.
+            def tell(self):
+                raise OSError('not seekable')
 
-        # ZipArchive doesn't apply the input-size check (only the
-        # parsers that slurp do), so use a parser class that does
-        # (EML), but with a wrapper that hides seek/tell. The
-        # `email.message_from_binary_file` call below will still work
-        # because Python's email parser reads sequentially.
-        with open(file=TEST_ARCHIVE_EML_SAMPLE_PATH, mode='rb') as file_object:
-            wrapper = _NonSeekableWrapper(file_object=file_object)
-            archive = EMLArchive()
-            # Must not raise ArchiveInputSizeExceeded.
-            archive._open(file_object=wrapper)
+            def seek(self, *args, **kwargs):
+                raise OSError('not seekable')
+
+        wrapper = _PipeLikeWrapper()
+        archive = ZipArchive()
+        archive._check_input_size(file_object=wrapper)
