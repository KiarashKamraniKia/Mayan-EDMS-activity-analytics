#: apps.py:32 permissions.py:6
msgid "Task manager"
msgstr "مدير المهام "

#: apps.py:116 apps.py:141 apps.py:184
msgid "Label"
msgstr "العنوان"

#: apps.py:120 apps.py:144 apps.py:188
msgid "Name"
msgstr "اسم"

#: apps.py:125
msgid "Default queue?"
msgstr "قائمة الانتظار"

#: apps.py:130
msgid ""
"Transient queues are not persistent. Tasks in a transient queue are lost if "
"the broker is restarted. Transient queues use less resources and managed non"
" critical tasks."
msgstr ""
"طوابير المؤقتة غير دائمة. يتم فقدان المهام في الطابور المؤقت إذا تم إعادة "
"تشغيل الوسيط. تستخدم الطوابير المؤقتة موارد أقل وتدير المهام غير الحرجة."

#: apps.py:133
msgid "Is transient?"
msgstr "هل تم الإضافة؟"

#: apps.py:147
msgid "Dotted path"
msgstr "مسار منقوط"

#: apps.py:151
msgid "Schedule"
msgstr "جدولة"

#: apps.py:157
msgid "Type"
msgstr "النوع"

#: apps.py:162
msgid "Start time"
msgstr "وقت البداية"

#: apps.py:166
msgid "Host"
msgstr "مضيف"

#: apps.py:170
msgid "Arguments"
msgstr "المحددات"

#: apps.py:174
msgid "Keyword arguments"
msgstr "المحددات الرئيسية"

#: apps.py:179
msgid "Worker process ID"
msgstr "رقم العمل للعميل"

#: apps.py:192
msgid ""
"Maximum amount of resident memory a worker can execute before it's replaced "
"by a new process."
msgstr ""
"الحد الأقصى لذاكرة الوصول العشوائي التي يمكن للعامل تنفيذها قبل استبداله "
"بعملية جديدة."

#: apps.py:194
msgid "Maximum memory per child"
msgstr "الحد الأقصى للذاكرة لكل عملية فرعية"

#: apps.py:198
msgid ""
"Maximum number of tasks a worker can execute before it's replaced by a new "
"process."
msgstr ""
"الحد الأقصى لعدد المهام التي يمكن للعامل تنفيذها قبل استبداله بعملية جديدة."

#: apps.py:200
msgid "Maximum tasks per child"
msgstr "الحد الأقصى للمهام لكل عملية فرعية"

#: apps.py:204
msgid ""
"The number of worker processes/threads to launch. Defaults to the number of "
"CPUs available on the machine."
msgstr ""
"عدد عمليات/خيوط العامل التي سيتم تشغيلها. القيمة الافتراضية هي عدد وحدات "
"المعالجة المتاحة في الجهاز."

#: apps.py:206
msgid "Concurrency"
msgstr "التزامن"

#: apps.py:210
msgid ""
"The nice value determines the priority of the process. A higher value lowers"
" the priority. The default value is 0."
msgstr ""
"تحدد قيمة nice أولوية العملية. كلما زادت القيمة انخفضت الأولوية. القيمة "
"الافتراضية هي 0."

#: apps.py:213
msgid "Nice level"
msgstr "مستوى nice"

#: classes.py:184
msgid "Task type count"
msgstr "عدد أنواع المهام"

#: classes.py:229
msgid "Queue count"
msgstr "عدد قوائم الانتظار"

#: links.py:13
msgid "Task type list"
msgstr "قائمة أنواع المهام"

#: links.py:18
msgid "Worker list"
msgstr "قائمة العاملين"

#: links.py:23
msgid "Queue list"
msgstr "قائمة الانتظار"

