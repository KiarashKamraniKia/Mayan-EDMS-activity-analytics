msgstr "Bootswatch"

#: templates/403.html:5 templates/403.html:18
msgid "Insufficient permission"
msgstr "Elégtelen jogosultság"

#: templates/403.html:20
msgid "You don't have enough permissions for this operation."
msgstr "Nincs elégséges engedélye ehhez a művelethez."

#: templates/404.html:5 templates/404.html:18
msgid "Page not found"
msgstr "Oldal nem található"

#: templates/404.html:20
msgid "The requested page could not be found."
msgstr "A keresett oldal nem található."

#: templates/404.html:28
msgid "Possible reasons"
msgstr "Lehetséges okok"

#: templates/404.html:32
msgid "The location of the item is incorrect."
msgstr "Az elem helye helytelen."

#: templates/404.html:33
msgid "The location is correct, but the item no longer exists."
msgstr "A hely megfelelő, de az elem már nem létezik."

#: templates/404.html:34
msgid ""
"The location is be correct, but your account does not have the required "
"permission to access it."
msgstr ""
"A hely megfelel, de fiókja nem rendelkezik a hozzáféréshez szükséges "
"engedéllyel."

#: templates/500.html:5 templates/500.html:18
#: templates/appearance/root.html:48
msgid "Server error"
msgstr "Szerver hiba"

#: templates/500.html:20
msgid "There's been an unexpected error."
msgstr "Váratlan hiba történt."

#: templates/500.html:28
msgid "What to do next?"
msgstr "Mi legyen a következő?"

#: templates/500.html:32
msgid "Refresh the page."
msgstr "Frissítse az oldalt."

#: templates/500.html:33
msgid "Wait a bit. The system might be overloaded."
msgstr "Várjon egy kicsit. Lehetséges, hogy a rendszer túlterhelt."

#: templates/500.html:34
msgid "Contact your system administrator."
msgstr "Forduljon a rendszergazdához."

#: templates/500.html:35
msgid "Check the logs for messages with the tags \"ERROR\", \"CRITICAL\" or \"FATAL\"."
msgstr ""
"Ellenőrizze, hogy a naplókban vannak-e \"ERROR\", \"CRITICAL\" vagy "
"\"FATAL\" címkével ellátott üzenetek."

#: templates/500.html:36
#, python-format
msgid "Open a ticket using the <a href=\"%(issue_url)s\">issue tracker</a>."
msgstr ""
"Nyisson meg egy hibajegyet a <a href=\"%(issue_url)s\">problémakövető</a> "
"segítségével."

#: templates/appearance/about.html:10
msgid "About"
msgstr "Névjegy"

#: templates/appearance/about.html:39
msgid "Version"
msgstr "Verzió"

#: templates/appearance/about.html:41
#, python-format
msgid "Build number: %(project_build_number)s"
msgstr "Build szám: %(project_build_number)s"

#: templates/appearance/about.html:48
msgid "Released under the license:"
msgstr "A licenc ami alapján megjelent:"

#: templates/appearance/about.html:59
#, python-format
msgid ""
"To get the latest news subscribe to the <a class=\"new_window\" "
"href=\"%(link_mailing_list_url)s\"> Mailing list</a>."
msgstr ""
"A legfrissebb hírekért iratkozzon fel a <a class=\"new_window\" "
"href=\"%(link_mailing_list_url)s\">levelezőlistára</a> ."

#: templates/appearance/about.html:68
#, python-format
msgid ""
"For articles, tutorials, troubleshooting, subscribe to the <a "
"class=\"new_window\" href=\"%(link_knowledge_base_url)s\"> Knowledge "
"base</a>."
msgstr ""
"Ha cikkeket, oktatóanyagokat és hibaelhárítást szeretne látni, iratkozzon "
"fel a <a class=\"new_window\" "
"href=\"%(link_knowledge_base_url)s\">Tudásbázisra</a> ."

#: templates/appearance/about.html:77
#, python-format
msgid ""
"Need professional help? Check out the <a class=\"new_window\" "
"href=\"%(link_support_url)s\"> Support</a> offerings."
msgstr ""
"Szakmai segítségre van szüksége? Tekintse meg a <a class=\"new_window\" "
"href=\"%(link_support_url)s\">támogatási</a> ajánlatokat."

#: templates/appearance/about.html:86
#, python-format
msgid ""
"For discussions visit the <a class=\"new_window\" "
"href=\"%(link_forum_url)s\">Community forum</a>."
msgstr ""
"Megbeszélésekhez látogasson el a <a class=\"new_window\" "
"href=\"%(link_forum_url)s\">közösségi fórumra</a> ."

#: templates/appearance/about.html:95
#, python-format
msgid ""
"The complete list of changes is available via the <a class=\"new_window\" "
"href=\"%(link_release_notes_url)s\">Release notes</a>."
msgstr ""
"A változtatások teljes listája a <a class=\"new_window\" "
"href=\"%(link_release_notes_url)s\">Kibocsátási megjegyzésekben</a> érhető "
"el."

#: templates/appearance/about.html:104
#, python-format
msgid ""
"For questions check the <a class=\"new_window\" "
"href=\"%(link_documentation_url)s\">Documentation</a>."
msgstr ""
"Kérdés esetén nézze meg a <a class=\"new_window\" "
"href=\"%(link_documentation_url)s\">Dokumentációt</a> ."

#: templates/appearance/about.html:113
#, python-format
msgid ""
"If you found a bug or have a feature idea open a ticket in the <a "
"class=\"new_window\" href=\"%(link_source_code_url)s\">Source code "
"repository</a>."
msgstr ""
"Ha hibát talált, vagy van egy funkcióötlete, nyisson hibajegyet a <a "
"class=\"new_window\" href=\"%(link_source_code_url)s\">forráskód "
"tárolóban</a> ."

#: templates/appearance/about.html:119
#, python-format
msgid ""
"%(project_title)s is Free and Open Source software, which is provided as-is "
"with no warranty."
msgstr ""
"%(project_title)s egy ingyenes és nyílt forráskódú szoftver, amely eredeti "
"állapotában, garancia nélkül kerül forgalomba."

