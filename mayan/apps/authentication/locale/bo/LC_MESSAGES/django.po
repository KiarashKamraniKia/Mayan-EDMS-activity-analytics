msgstr "གོམ་པ་ %(step)d ཡི་ %(total_steps)d : %(step_label)s"

#: views/authentication_views.py:190
msgid "Sign in"
msgstr "ནང་དུ་འཛུལ་བ།"

#: views/authentication_views.py:240
msgid "Your password has been successfully changed."
msgstr "ཁྱེད་ཀྱི་གསང་གྲངས་བདེ་བླག་ངང་བསྒྱུར་བཅོས་བྱས་ཟིན།"

#: views/authentication_views.py:251
msgid "Current user password change"
msgstr "མིག་སྔའི་སྤྱོད་མཁན་གྱི་གསང་གྲངས་བསྒྱུར།"

#: views/authentication_views.py:263
msgid "Changing the password is not allowed for this account."
msgstr "རྩིས་ཁྲ་འདིའི་གསང་གྲངས་བསྒྱུར་མི་ཆོག"

#: views/authentication_views.py:362
#, python-format
msgid "Password change request performed on %(count)d user"
msgstr ""
"གསང་གྲངས་བརྗེ་སྒྱུར་གྱི་རེ་འདུན་དེ་ %(count)d སྤྱོད་མཁན་ཐོག་སྒྲུབ་ཡོད།"

#: views/authentication_views.py:365
#, python-format
msgid "Password change request performed on %(count)d users"
msgstr "གསང་གྲངས་བརྗེ་སྒྱུར་གྱི་རེ་འདུན་དེ་ %(count)d སྤྱོད་མཁན་ལ་སྒྲུབ་ཡོད།"

#: views/authentication_views.py:382
msgid ""
"Changing the password of staff or super user accounts via the user interface"
" is not allowed. Use administration tools to perform this operation."
msgstr ""
"ལས་བྱེད་པའམ་ཡང་ན་སྤྱོད་མཁན་ཆེ་ཤོས་ཀྱི་རྩིས་ཁྲའི་གསང་ཚིག་སྤྱོད་མཁན་གྱི་མཐུད་ཁ་བརྒྱུད་ནས་བརྗེ་སྒྱུར་བྱེད་མི་ཆོག"
" བཀོལ་སྤྱོད་འདི་སྒྲུབ་པར་འཛིན་སྐྱོང་ལག་ཆ་བེད་སྤྱོད་བྱེད་དགོས།"

#: views/authentication_views.py:396
msgid "Change user password"
msgid_plural "Change users passwords"
msgstr[0] "སྤྱོད་མཁན་གྱི་གསང་གྲངས་བརྗེ་དགོས།"

