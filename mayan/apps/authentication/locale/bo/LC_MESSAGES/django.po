#: permissions.py:10
msgid "Impersonate users"
msgstr "སྤྱོད་མཁན་རྫུན་བཟོ་བྱེད་པ།"

#: settings.py:17
msgid ""
"Remove the \"Forgot your password?\" link on the login form used to trigger "
"the password reset."
msgstr ""
"གསང་གྲངས་བསྐྱར་སྒྲིག་བྱེད་པར་བེད་སྤྱོད་བྱེད་པའི་ནང་འཇུག་འབྲི་ཤོག་སྟེང་གི་&quot;ཁྱེད་ཀྱི་གསང་གྲངས་བརྗེད་སོང་ངམ།&quot;"
" འབྲེལ་མཐུད་དེ་མེད་པར་བཟོས།"

#: settings.py:25
msgid "Dotted path to the backend used to process user authentication."
msgstr ""
"བཀོལ་སྤྱོད་པའི་བདེན་དཔང་ལས་སྣོན་བྱེད་པར་བེད་སྤྱོད་བྱེད་པའི་རྒྱབ་ཕྱོགས་ལ་ཚག་ཡོད་པའི་འགྲོ་ལམ།"

#: settings.py:32
msgid "Arguments for the AUTHENTICATION_BACKEND."
msgstr "AUTHENTICATION_BACKEND དོན་གྱི་ཨར་གུ་མེན་ཊི་ (Arguments) ཁག"

#: templates/authentication/app/viewport.html:13
