msgstr "སྤྱོད་མཁན་གྱི་གསང་གྲངས་བསྒྱུར། %s"

#: views/authentication_views.py:431
#, python-format
msgid "Successful password reset for user: %s."
msgstr "བཀོལ་སྤྱོད་པའི་ཆེད་དུ་གསང་གྲངས་སླར་གསོ་མཐར་ཕྱིན་བྱས། %s ."

#: views/authentication_views.py:437
#, python-format
msgid "Error resetting password for user \"%(user)s\": %(error)s"
msgstr ""
"སྤྱོད་མཁན་གྱི་གསང་གྲངས་སླར་གསོ་བྱེད་པའི་ནོར་འཁྲུལ་ %(error)s བ %(user)s"

